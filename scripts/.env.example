# Kopiraj ovu datoteku u root projekta kao  .env  (G:\Deliblato\.env)
# i upisi svoje Copernicus (CDSE) OAuth podatke.
#
# Gdje ih naci: https://shapps.dataspace.copernicus.eu/dashboard/
#   -> User settings -> OAuth clients -> "Create" (dobijes ID i Secret)
#
# VAZNO: .env NE dijeli i NE stavljaj u git (secret je kao lozinka).

SH_CLIENT_ID=ovdje-tvoj-client-id
SH_CLIENT_SECRET=ovdje-tvoj-client-secret
